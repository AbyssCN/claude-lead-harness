#!/usr/bin/env node
// piw(原 omd-lite;bin/omd-lite 是指向本文件的软链,旧名字照常可用):在隔离 worktree 里用 pi 跑一个任务书,闸在模型之外(ext/gate-loop.ts)。
// 用法见 README.md。只依赖 node 标准库。
"use strict";
const { spawnSync, spawn } = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");
const os = require("node:os");
const piw = require("../lib/piw");
// lib/*.mjs 是 ESM。CJS 里 require 一个正在被别的线程动态 import 的 ESM 文件会炸:
// ERR_INTERNAL_ASSERTION "Cannot require() ES Module … because it is not yet fully loaded"。
// node --test 跑全量时正好撞上(测试里 await import('../lib/slot-queue.mjs') 与别处 require 本文件同时发生),
// 报成整轮 test 失败。所以改成用的时候再 require:模块加载期不碰 ESM,竞态消失,调用点写法不变。
const esmCache = new Map();
const esmFn = (file, name) => (...args) => {
  if (!esmCache.has(file)) esmCache.set(file, require(file));
  return esmCache.get(file)[name](...args);
};
// 任务书解析只有一个实现(F1):lib/brief.mjs 是 factory/lib/brief.mjs 的逐字副本,piw 不再自带一份正则
const allowedList = esmFn("../lib/brief.mjs", "allowedList");
// 工厂事件流(F2):一行一事件,只追加;lib/events.mjs 是 factory 侧的逐字副本,本文件只调它
const appendEvent = esmFn("../lib/events.mjs", "appendEvent");
const importGateEvents = esmFn("../lib/gate-events.mjs", "importGateEvents");
const lastActivity = esmFn("../lib/slot-queue.mjs", "lastActivity");
const classOfResult = esmFn("../lib/round-classify.mjs", "classOfResult");

const ROOT = path.resolve(__dirname, "..");
const RUNS = path.join(os.homedir(), ".omd-lite", "runs");
// 环境变量双读:PIW_X ?? OMD_LITE_X(新名优先,旧名兜底)。写出给子进程的变量两个名字都写,OMD_LITE_OUT 必须保留
// (myapp scripts/dev/_untrusted.sh 用它判断不受信 agent)。
const envv = (name, env = process.env) => env[`PIW_${name}`] ?? env[`OMD_LITE_${name}`];
const ENV_FILE = envv("ENV_FILE") || path.join(os.homedir(), ".config", "piw", "provider.env");
// 主模型因供应商报错中途停下(闸一轮没判)时，在同一 worktree 换它重跑一次。03.10 实测两种:429 额度上限(2056)· 流中途断开
const DEFAULT_FALLBACK = "deepseek/deepseek-v4-flash";
// 预算闸默认值(26.10,otherapp docs/plan/10.26/token-yield.md H3):全价口径累计 token;10-23 起闸绿片 p90 ≈ 25M。--token-budget 0 = 不限
const DEFAULT_TOKEN_BUDGET = 25e6;
// gate-loop 闸在跑时写在 run 目录的标记(ext/gate-loop.ts GATE_RUNNING):墙钟见它暂停
const GATE_RUNNING = "gate-running";
const USAGE = `用法:
  piw run --repo <path> --base <ref> --spec <仓内路径> --model <provider/id[:thinking]>
