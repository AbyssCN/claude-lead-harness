{
  "include": ["docs/marketing/**", "web/messages/*.json", "web/content/**/*.{md,mdx}"],
  "exclude": ["docs/marketing/style-guide.md"],
  "banned": [
    { "word": "leverage", "reason": "write \"use\"" },
    { "word": "synergy", "reason": "say what actually happens" },
    { "word": "best-in-class", "reason": "unprovable claim" },
    { "pattern": "\\bseamless(ly)?\\b", "flags": "i", "reason": "empty filler" },
    { "pattern": "no credit card required", "flags": "i", "reason": "retired tagline" }
  ],
  "headingNoTrailing": "。.",
  "guide": "docs/marketing/style-guide.md"
}
